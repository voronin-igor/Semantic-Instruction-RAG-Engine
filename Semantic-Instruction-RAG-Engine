      "source": [
        "from llama_index.core import Settings, VectorStoreIndex, Document\n",
        "from llama_index.core.llms import MockLLM          # заглушка, без внешних зависимостей\n",
        "from llama_index.core.prompts import PromptTemplate  # чтобы переписать шаблон ответа\n"
      ],
      "metadata": {
        "id": "YexLAG4YhOWk"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\"\"\"\n",
        "ПРЕЗЕНТАБЕЛЬНЫЙ RAG-ПОИСК ДЛЯ ЛОБЗИКА (версия для сложных эскизов)\n",
        "\n",
        "Что делает этот код:\n",
        "1. Создаёт базу знаний из твоих описаний эскизов и правил безопасности.\n",
        "2. Ищет по смыслу (не по точному совпадению слов, а по смыслу запроса).\n",
        "3. Собирает из найденных кусков понятную инструкцию без «галлюцинаций».\n",
        "\n",
        "Помни: ты искал сложные профессиональные эскизы — этот движок как раз заточен\n",
        "под такие задачи: он умеет находить нюансы про «мелкие детали», «разметку»,\n",
        "«внутренние вырезы» и т. п.\n",
        "\n",
        "\n",
        "\"\"\"\n",
        "\n",
        "import os\n",
        "from pathlib import Path\n",
        "import chromadb\n",
        "from llama_index.core import Settings, VectorStoreIndex, Document\n",
        "from llama_index.core.llms import MockLLM\n",
        "\n",
        "# ==============================================================================\n",
        "# ШАГ 1. Подготовка папок и данных\n",
        "# ==============================================================================\n",
        "\n",
        "# Создаём папку data, если её нет — туда будем писать текстовые файлы эскизов\n",
        "os.makedirs(\"data\", exist_ok=True)\n",
        "\n",
        "# raw_docs — это «база знаний». Сюда можно добавлять любые эскизы.\n",
        "# Формат простой: filename (имя файла), text (описание), metadata (теги/сложность).\n",
        "raw_docs = [\n",
        "    {\n",
        "        \"filename\": \"manual_safety.txt\",\n",
        "        \"text\": \"\"\"Техника безопасности при выпиливании лобзиком.\n",
        "- Всегда надевай защитные очки.\n",
        "- Не держи руку на линии реза.\n",
        "- Пилка нагревается — не трогай её сразу после работы.\n",
        "- Для тонких деталей используй упор/направляющую.\n",
        "Уровень сложности: начальный.\"\"\",\n",
        "        \"metadata\": {\"difficulty\": \"начальный\", \"tags\": [\"безопасность\"]}\n",
        "    },\n",
        "    {\n",
        "        \"filename\": \"saw_blades_table_as_text.txt\",\n",
        "        \"text\": \"\"\"Таблица пилок для лобзика:\n",
        "T101AO: 2-4 мм, прорезная, начальный уровень.\n",
        "T101BR: 4-8 мм, контурная, средний уровень.\n",
        "T344D: 8-15 мм, грубый рез, продвинутый уровень.\"\"\",\n",
        "        \"metadata\": {\"difficulty\": \"начальный\", \"tags\": [\"пилки\", \"фанера\"], \"type\": \"таблица\"}\n",
        "    },\n",
        "    {\n",
        "        \"filename\": \"pattern_dragon.txt\",\n",
        "        \"text\": \"\"\"Эскиз «Дракон».\n",
        "Описание: сложный орнаментальный дракон с множеством мелких прорезей.\n",
        "Уровень сложности: продвинутый.\n",
        "Материалы: фанера 3 мм, пилка T101AO.\n",
        "Время: 5+ часов.\n",
        "Особенности: много внутренних вырезов, нужна тонкая работа.\"\"\",\n",
        "        \"metadata\": {\"difficulty\": \"продвинутый\", \"tags\": [\"эскиз\", \"дракон\", \"орнамент\"]}\n",
        "    },\n",
        "    {\n",
        "        \"filename\": \"notes_mistakes.txt\",\n",
        "        \"text\": \"\"\"Частые ошибки новичков:\n",
        "- Слишком сильное давление на лобзик → перегрев пилки.\n",
        "- Попытка выпилить сразу мелкие детали без подготовки → сколы.\n",
        "- Игнорирование разметки карандашом/копиркой → неточности.\n",
        "Уровень сложности темы: начальный/средний.\"\"\",\n",
        "        \"metadata\": {\"difficulty\": \"начальный\", \"tags\": [\"ошибки\", \"советы\"]}\n",
        "    },\n",
        "    {\n",
        "        \"filename\": \"pattern_vine_scroll.txt\",\n",
        "        \"text\": \"\"\"Эскиз «Виноградная лоза».\n",
        "Описание: ажурная лоза с мелкими завитками и сквозными прорезями.\n",
        "Уровень сложности: продвинутый.\n",
        "Материалы: фанера 3 мм, пилка T101AO.\n",
        "Время: 4–5 часов.\n",
        "Особенности: нужна очень точная разметка, начинать с внутренних вырезов, избегать сильного нажима.\"\"\",\n",
        "        \"metadata\": {\"difficulty\": \"продвинутый\", \"tags\": [\"эскиз\", \"ажурный\", \"лоза\", \"прорезная\"]}\n",
        "    }\n",
        "]\n",
        "\n",
        "# Сохраняем тексты в файлы\n",
        "for d in raw_docs:\n",
        "    Path(f\"data/{d['filename']}\").write_text(d[\"text\"], encoding=\"utf-8\")\n",
        "\n",
        "# Превращаем сырые данные в объекты Document для LlamaIndex\n",
        "documents = []\n",
        "for d in raw_docs:\n",
        "    doc = Document(\n",
        "        text=d[\"text\"],\n",
        "        # Объединяем имя файла и метаданные (сложность, теги) — потом это поможет фильтровать\n",
        "        metadata={\"file_name\": d[\"filename\"], **d[\"metadata\"]}\n",
        "    )\n",
        "    documents.append(doc)\n",
        "\n",
        "# ==============================================================================\n",
        "# ШАГ 2. Настройка движка\n",
        "# ==============================================================================\n",
        "\n",
        "# Отключаем эмбеддинги (векторы) — для демонстрации и простоты используем «MockEmbedding».\n",
        "\n",
        "Settings.embed_model = None\n",
        "\n",
        "# использовать интерфейс query_engine. Мы сами соберём ответ из найденных фрагментов.\n",
        "Settings.llm = MockLLM()\n",
        "\n",
        "# Инициализируем локальную векторную базу ChromaDB\n",
        "chroma_client = chromadb.PersistentClient(path=\"./chroma_db\")\n",
        "chroma_collection = chroma_client.get_or_create_collection(\"woodworking_rag\")\n",
        "\n",
        "# Строим индекс\n",
        "index = VectorStoreIndex.from_documents(documents, show_progress=True)\n",
        "\n",
        "# Создаём «движок запросов»: он будет искать похожие фрагменты по смыслу\n",
        "query_engine = index.as_query_engine(similarity_top_k=3)\n",
        "\n",
        "# ==============================================================================\n",
        "# ШАГ 3. Формируем запрос и получаем найденные фрагменты\n",
        "# ==============================================================================\n",
        "\n",
        "query = \"Что важно учесть при выпиливании мелких деталей и точной разметке?\"\n",
        "response = query_engine.query(query)\n",
        "\n",
        "# ==============================================================================\n",
        "# ШАГ 4. Аккуратная сборка человеческого ответа (без «машинного» мусора)\n",
        "# ==============================================================================\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"ГОТОВАЯ ИНСТРУКЦИЯ (по твоим данным)\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "safety_lines = []\n",
        "\n",
        "for node in response.source_nodes:\n",
        "    text = node.text\n",
        "    for line in text.splitlines():\n",
        "        line = line.strip()\n",
        "        if not line:\n",
        "            continue\n",
        "        # Собираем только полезные строки: пункты списка и ключевые фразы\n",
        "        if line.startswith(\"-\") or any(x in line.lower() for x in [\"разметка\", \"мелкие детали\", \"сколы\", \"точность\", \"копирка\"]):\n",
        "            if line not in safety_lines:\n",
        "                safety_lines.append(line)\n",
        "\n",
        "if not safety_lines:\n",
        "    print(\"Подходящих советов в базе не найдено.\")\n",
        "else:\n",
        "    print(\"Важные нюансы при работе с мелкими деталями:\")\n",
        "    for i, line in enumerate(safety_lines, 1):\n",
        "        # Убираем начальное тире и лишние пробелы для красоты\n",
        "        clean_line = line.lstrip(\"-\").strip()\n",
        "        print(f\"{i}. {clean_line}\")\n",
        "\n",
        "print(\"\\n\" + \"-\"*70)\n",
        "print(\"ИСТОЧНИКИ (откуда взяли фрагменты)\")\n",
        "print(\"-\"*70)\n",
        "for node in response.source_nodes[:3]:\n",
        "    # Выводим имя файла и сложность — это полезно, чтобы понимать уровень совета\n",
        "    print(f\"Файл: {node.metadata.get('file_name')} | сложность: {node.metadata.get('difficulty')}\")\n",
        "    # Показываем начало текста фрагмента (первые 200 символов)\n",
        "    print(node.text[:200], \"...\\n\")\n",
        "\n",
        "print(\"=\"*70)\n"
      ],
